# answerbank environment configuration
#
# Copy to .env if you want it. You do not need any of this. answerbank is
# fully functional with an empty environment, and the two variables that
# reach the network are only read by the `pull` and `push` commands.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key. If you keep your library
# under git, note that .env belongs next to the code, not inside the
# library directory.


# ---------------------------------------------------------------------------
# Where your library lives
# ---------------------------------------------------------------------------

# Root directory containing one subdirectory per organization. If unset,
# answerbank looks for ./answerbank.toml, then walks up, then falls back to
# ~/answerbank. The --library flag beats this variable.
# ANSWERBANK_HOME=/Users/dana/answerbank

# Organization slug used when a command omits --org. Overrides default_org
# in answerbank.toml, which is the better place to set it permanently.
# Useful for a shell session spent on one client.
# ANSWERBANK_DEFAULT_ORG=riverkeeper


# ---------------------------------------------------------------------------
# Optional: OpenGrants enrichment
# ---------------------------------------------------------------------------

# Only used by `answerbank pull` and `answerbank push`. Without it those two
# commands print one line explaining they need a key and exit cleanly. Every
# other command behaves identically whether this is set or not.
#
# Keys come from the OpenGrants Developer Dashboard. `push` requires the Pro
# or Developer tier because it calls the match-grants endpoint.
# OPENGRANTS_API_KEY=

# Override only if you are pointing at a staging deployment.
# Default: https://qnoicxojartltrownmal.supabase.co/functions/v1/
# OPENGRANTS_API_BASE=


# ---------------------------------------------------------------------------
# Output behaviour
# ---------------------------------------------------------------------------

# Any non-empty value disables ANSI color in terminal output. Respected as a
# matter of course; the tool also disables color automatically when stdout is
# not a terminal, so piping already does the right thing.
# NO_COLOR=1

# Editor used by `answerbank edit`. Falls back to $VISUAL, then $EDITOR, then
# a platform default.
# EDITOR=vim
